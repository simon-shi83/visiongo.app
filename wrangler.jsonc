{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visiongo-website",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Canonical origin of the international edition. The China edition sets
  // PUBLIC_ORIGIN=https://visiongo.com.cn in deploy/visiongo-website.service.
  // Sign-in with Google and GitHub only (GOOGLE_CLIENT_ID, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET as secrets).
  // Every deploy replaces the variables with "vars" below: credentials set as plain
  // dashboard variables are lost, so set them with `wrangler secret put`.
  // CLOUD_API_URL: the VisionCloud whose /v1/accounts holds this edition's organization credits.
  "vars": { "PUBLIC_ORIGIN": "https://visiongo.app", "AUTH_METHODS": "google,github", "CLOUD_API_URL": "https://cloud.visiongo.com.cn" },
  // Bindings are also replaced on every deploy (CI deploys on push), so the
  // international database stays declared here. The China edition uses SQLite.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visiongo_db",
      "database_id": "21da853e-bd5e-4620-a108-49dc34038612",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // To enable Cloudflare Workers Analytics Engine:
  // 1. Visit: https://dash.cloudflare.com/9a750ae5472b30301cd3aa878c5da2a9/workers/analytics-engine
  // 2. Click "Enable Analytics Engine" (Free tier available)
  // 3. Uncomment the block below:
  // "analytics_engine_datasets": [
  //   {
  //     "binding": "DOWNLOADS_ANALYTICS",
  //     "dataset": "visiongo_downloads"
  //   }
  // ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "visiongo.app",
      "custom_domain": true
    },
    {
      "pattern": "www.visiongo.app",
      "custom_domain": true
    }
  ]
}
