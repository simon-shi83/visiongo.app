[Unit]
Description=VISIONGO website and identity API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ibm-rs240-svr
Group=ibm-rs240-svr
WorkingDirectory=/home/ibm-rs240-svr/VISIONGO/visiongo.app
Environment=NODE_ENV=production
Environment=PORT=8600
Environment=PUBLIC_ORIGIN=https://visiongo.com.cn
Environment=DEFAULT_LOCALE=zh
# VisionCloud panels that sign in with this edition (see .env.example).
Environment=PORTAL_REDIRECT_URIS=https://cloud.visiongo.com.cn/v1/admin
# VisionCloud of this edition: organization credits, ledger and usage.
Environment=CLOUD_API_URL=https://cloud.visiongo.com.cn
# Email accounts only (verification codes via Resend: RESEND_API_KEY in .env).
Environment=AUTH_METHODS=email
Environment="EMAIL_FROM=VISIONGO <no-reply@visiongo.com.cn>"
Environment=DATABASE_PATH=/home/ibm-rs240-svr/VISIONGO/visiongo.app/data/website.sqlite
ExecStart=/home/ibm-rs240-svr/VISIONGO/visiongo.app/runtime/bin/node --env-file=.env deploy/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ibm-rs240-svr/VISIONGO/visiongo.app/data

[Install]
WantedBy=multi-user.target
