# ==============================================================================
# VISIONGO Web Platform - Environment & Secrets Configuration Template
# ==============================================================================
# DO NOT commit real secrets to version control.
# For local development with wrangler: copy this to .dev.vars
# For production Cloudflare Workers: use `wrangler secret put <KEY>`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub Private Release Integration (Phase 2)
# ------------------------------------------------------------------------------
# Fine-grained Personal Access Token (PAT) with read-only access to releases and contents
# for the private repositories: VisionStudio, VisionRuntime, VisionEdge.
# Never expose this token to browser JavaScript.
GITHUB_RELEASE_TOKEN=github_pat_EXAMPLE_TOKEN_READ_ONLY_RELEASES

# GitHub organization or user owning the private repositories (default: simon-shi83)
GITHUB_ORG=simon-shi83

# Private repository names
VISIONSTUDIO_REPO=VisionStudio
VISIONRUNTIME_REPO=VisionRuntime
VISIONEDGE_REPO=VisionEdge

# In-worker cache time-to-live for GitHub release metadata (in seconds, default: 600 = 10 mins)
DOWNLOADS_CACHE_TTL_SEC=600

# ------------------------------------------------------------------------------
# 2. Privacy-Conscious Download Analytics (Workers Analytics Engine)
# ------------------------------------------------------------------------------
# Server-side cryptographic secret used to compute non-reversible pseudonymous HMAC hashes
# from connecting IP addresses. Allows aggregate download counting without storing raw IPs.
DOWNLOAD_ANALYTICS_SECRET=visiongo_super_secret_hmac_salt_2026

# ------------------------------------------------------------------------------
# 3. Enterprise Contact Inquiries (Optional External Dispatcher)
# ------------------------------------------------------------------------------
# Inquiry notifications use RESEND_API_KEY after durable D1 storage.
# Optional recipient; requires a verified contact@visiongo.app sender.
CONTACT_EMAIL_TO=contact@visiongo.app

# ------------------------------------------------------------------------------
# 4. Google Authentication & Sessions (Phase 3)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID generated from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# GitHub OAuth App credentials generated from GitHub Developer Settings
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
VITE_GITHUB_CLIENT_ID=your_github_client_id

# Required for email verification and inquiry email notifications
RESEND_API_KEY=re_your_resend_api_key

# Cryptographic secret for signing HttpOnly session cookies (vg_session)
# In production, configure with: wrangler secret put SESSION_SECRET
SESSION_SECRET=visiongo_secure_session_signing_key_2026

# VisionStudio 桌面会话令牌使用独立的 RSA 私钥签名，不能复用 SESSION_SECRET。
# 生产环境执行：wrangler secret put DESKTOP_TOKEN_PRIVATE_KEY
# 值必须是 PKCS#8 PEM（-----BEGIN PRIVATE KEY-----）。
DESKTOP_TOKEN_PRIVATE_KEY="replace-with-pkcs8-private-key"
DESKTOP_TOKEN_KEY_ID=website-desktop-1
DESKTOP_TOKEN_ISSUER=https://visiongo.app
# Web pages (exact https URLs, comma-separated) that /auth/desktop may return an
# authorization code to: the VisionCloud panels that trust this edition.
# China edition: set in deploy/visiongo-website.service. International: empty until it has a VisionCloud.
# PORTAL_REDIRECT_URIS=https://api.visiongo.com.cn/v1/admin
# VisionCloud of this edition, read for organization credits, ledger and usage (SDK credits contract).
# China edition: set in deploy/visiongo-website.service. International: empty until it has a VisionCloud.
# CLOUD_API_URL=https://api.visiongo.com.cn
# VisionCloud address handed to Studio and Edge in desktop tokens (cloud_base_url); Edge remembers it
# on the first sign-in. China edition: deploy/visiongo-website.service. International: wrangler.jsonc.
# CLOUD_BASE_URL=https://api.visiongo.com.cn
# Sign-in methods of this edition: email, google, github (comma-separated). Unset: all three.
# China edition: email (deploy/visiongo-website.service). International: google,github (wrangler.jsonc).
# AUTH_METHODS=email
# Sender of verification emails; its domain must be verified in Resend. Unset: no-reply@ the edition's host.
# EMAIL_FROM=VISIONGO <no-reply@visiongo.com.cn>

# ------------------------------------------------------------------------------
# 5. Edition
# ------------------------------------------------------------------------------
# Canonical origin. International: wrangler.jsonc vars. China edition:
# deploy/visiongo-website.service, which also sets PORT and DATABASE_PATH.
# Builds for the China edition must pass it too: PUBLIC_ORIGIN=https://visiongo.com.cn npm test
# PUBLIC_ORIGIN=https://visiongo.com.cn
# PORT=8600
# DATABASE_PATH=data/website.sqlite

# ------------------------------------------------------------------------------
# 6. Cloudflare D1 Database Binding (Phase 3)
# ------------------------------------------------------------------------------
# Database name for user accounts and download history.
# Create with: npx wrangler d1 create visiongo_db
# Apply migrations 0001 through 0004 in order; apply only missing migrations for an existing DB.
# In wrangler.jsonc, bind:
# [[d1_databases]]
# binding = "DB"
# database_name = "visiongo_db"
# database_id = "<DATABASE_UUID>"
